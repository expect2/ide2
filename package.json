{
  "name": "ide2",
  "productName": "ide2",
  "version": "0.1.0",
  "private": true,
  "description": "ide2 — read-only, JetBrains-inspired IDE for the AI coding era",
  "type": "module",
  "main": "./dist/main/index.cjs",
