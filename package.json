    "@vscode/ripgrep": "^1.15.9",
    "diff": "^7.0.0",
    "electron": "^35.0.0",
    "mermaid": "^11.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.2.0",
    "tree-sitter-wasms": "^0.1.13",
