{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@expect2/ide2-plugin/server": ["./src/plugin-sdk/server.ts"],
      "@expect2/ide2-plugin/client": ["./src/plugin-sdk/client.tsx"]
    }
  },
  "include": ["src/**/*", "plugins/**/*", "tests/**/*"]
}
